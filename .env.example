# Set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Required. From https://platform.claude.com (Console → API keys).
ANTHROPIC_API_KEY=

# Required. Comma-separated emails allowed to use the AI and lookup routes.
# The routes refuse everyone when this is empty.
ALLOWED_EMAILS=you@example.com

# Optional. Defaults to claude-sonnet-5-5.
CLAUDE_MODEL=

# Optional. Free key from https://fdc.nal.usda.gov/api-key-signup. Without it the
# shared DEMO_KEY is used, which is heavily rate-limited.
USDA_API_KEY=
